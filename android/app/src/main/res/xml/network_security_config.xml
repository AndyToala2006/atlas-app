<?xml version="1.0" encoding="utf-8"?>
<!--
  Politica de seguridad de red de Atlas.

  Android 9 (API 28) en adelante bloquea por defecto el trafico HTTP sin cifrar.
  El backend de desarrollo (atlas-backend) se sirve por http en la red local,
  asi que se habilita una excepcion ACOTADA a los hosts de desarrollo. El resto
  del trafico de la aplicacion sigue exigiendo HTTPS.

  IMPORTANTE: este bloque <domain-config> debe eliminarse antes de generar
  cualquier build de distribucion (release / Play Store).
-->
<network-security-config>

    <!-- Regla general: ningun dominio puede viajar sin cifrar. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Excepcion unica para el entorno de desarrollo. -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- IP del computador de desarrollo en la red Wi-Fi local. Es la
             direccion que usa el DISPOSITIVO FISICO para alcanzar el backend.
             La asigna el router por DHCP y cambia al reconectarse, por lo que
             la mantiene actualizada herramientas/configurar-host.ps1
             (run.ps1 lo invoca solo). No editar a mano las dos lineas de abajo. -->
        <!-- HOST-DESARROLLO:INICIO -->
        <domain includeSubdomains="false">192.168.100.116</domain>
        <!-- HOST-DESARROLLO:FIN -->

        <!-- Alias que el emulador de Android usa para llegar al localhost del anfitrion. -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- Solo utiles cuando la app corre en el propio computador (web/escritorio). -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

</network-security-config>
